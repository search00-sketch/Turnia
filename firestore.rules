rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas de otra app que ya vive en este mismo proyecto de Firebase
    // ("coyote-house" es un proyecto compartido). NO TOCAR esta parte:
    // no tiene relación con Turnia.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Turnia: directorio de negocios. Un documento por negocio, y su ID
    // es exactamente el uid del dueño en Firebase Auth. Eso hace que la
    // regla de escritura sea así de simple: sólo el dueño de la cuenta
    // puede editar su propio negocio; cualquiera puede leer los publicados
    // (el filtro published==true lo aplica el sitio al consultar).
    match /businesses/{businessId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == businessId;
    }
  }
}
